{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://brynz.local/schema/output.schema.json",
  "title":"Brynz Property Capture Unified Output",
  "type":"object",
  "required":["schema_version","capture","device","rooms","property_plan","damage","concealed_damage_flags","scope","confidence","validation","provenance","limitations"],
  "properties":{
    "schema_version":{"type":"string"},
    "capture":{"type":"object","required":["capture_id","tier","source","metric_status"],"properties":{
      "capture_id":{"type":"string"},"tier":{"enum":["photos","video","lidar"]},"source":{"type":"string"},
      "metric_status":{"enum":["calibrated","not_calibrated","partial"]},"frame_count":{"type":"integer","minimum":0}
    }},
    "device":{"type":"object","properties":{
      "model":{"type":"string"},"platform":{"type":"string"},"rgb":{"type":"boolean"},
      "depth":{"type":"boolean"},"lidar":{"type":"boolean"},"poses":{"type":"boolean"},"intrinsics":{"type":"boolean"}
    }},
    "rooms":{"type":"array","items":{"$ref":"#/$defs/room"}},
    "walls":{"type":"array","items":{"$ref":"#/$defs/wall"}},
    "openings":{"type":"array","items":{"$ref":"#/$defs/opening"}},
    "measurements":{"type":"array","items":{"$ref":"#/$defs/measurement"}},
    "property_plan":{"type":"object","required":["rooms","connectors","adjacency_graph"],"properties":{
      "rooms":{"type":"array","items":{"type":"string"}},"connectors":{"type":"array","items":{"type":"string"}},
      "adjacency_graph":{"type":"array","items":{"type":"object","required":["from","to"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"via":{"type":"string"}}}},
      "whole_property_footprint_m2":{"type":["number","null"]},"metric_status":{"type":"string"}
    }},
    "damage":{"type":"array","items":{"$ref":"#/$defs/damage"}},
    "concealed_damage_flags":{"type":"array","items":{"$ref":"#/$defs/flag"}},
    "scope":{"type":"array","items":{"$ref":"#/$defs/scope"}},
    "confidence":{"type":"object","properties":{"status":{"enum":["calibrated","not_calibrated"]},"method":{"type":"string"},"calibration_dataset":{"type":["string","null"]}}},
    "validation":{"type":"object","properties":{"status":{"type":"string"},"gates":{"type":"object"},"ground_truth_available":{"type":"boolean"}}},
    "provenance":{"type":"object","properties":{"software_version":{"type":"string"},"commands":{"type":"array","items":{"type":"string"}},"source_files":{"type":"array","items":{"type":"string"}}}},
    "limitations":{"type":"array","items":{"type":"string"}}
  },
  "$defs":{
    "measurement":{"type":"object","required":["name","value","unit","method","validation_status"],"properties":{
      "name":{"type":"string"},"value":{"type":["number","null"]},"unit":{"type":"string"},
      "confidence_interval":{"type":["object","null"],"properties":{"low":{"type":"number"},"high":{"type":"number"}}},
      "not_calibrated":{"type":"boolean"},"method":{"type":"string"},
      "validation_status":{"enum":["VALIDATED","NOT_EVALUATED","PENDING_PHYSICAL_VALIDATION","GROUND_TRUTH_REQUIRED","NOT_CALIBRATED"]}
    }},
    "room":{"type":"object","required":["room_id","polygon","measurements"],"properties":{
      "room_id":{"type":"string"},"polygon":{"type":"array","items":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2}},
      "floor_area_m2":{"type":["number","null"]},"ceiling_height_m":{"type":["number","null"]},
      "walls":{"type":"array","items":{"type":"string"}},"openings":{"type":"array","items":{"type":"string"}},
      "damage_regions":{"type":"array","items":{"type":"string"}},"adjacent_rooms":{"type":"array","items":{"type":"string"}},
      "measurements":{"type":"array","items":{"$ref":"#/$defs/measurement"}}
    }},
    "wall":{"type":"object","required":["wall_id","room_id","p0","p1","length_m"],"properties":{
      "wall_id":{"type":"string"},"room_id":{"type":"string"},"p0":{"$ref":"#/$defs/point"},"p1":{"$ref":"#/$defs/point"},"length_m":{"type":"number"},
      "confidence":{"type":"number","minimum":0,"maximum":1},"validation_status":{"type":"string"}
    }},
    "opening":{"type":"object","required":["opening_id","room_id","wall_id","type","position","width"],"properties":{
      "opening_id":{"type":"string"},"room_id":{"type":"string"},"wall_id":{"type":"string"},"type":{"enum":["door","window","unknown"]},
      "position":{"$ref":"#/$defs/point"},"width":{"type":["number","null"]},"confidence":{"type":"number","minimum":0,"maximum":1},
      "validation_status":{"type":"string"}
    }},
    "damage":{"type":"object","required":["damage_id","room_id","class","region","confidence","validation_status"],"properties":{
      "damage_id":{"type":"string"},"room_id":{"type":"string"},"class":{"enum":["water_stain","crack_surface_damage","unknown"]},
      "severity":{"type":"string"},"candidate_severity":{"type":"string"},"region":{"type":"object"},
      "estimated_extent":{"type":["number","null"]},"evidence_frames":{"type":"array","items":{"type":"string"}},
      "confidence":{"type":"number","minimum":0,"maximum":1},"validation_status":{"type":"string"}
    }},
    "flag":{"type":"object","required":["flag_id","room_id","reason","evidence","confidence","status"],"properties":{
      "flag_id":{"type":"string"},"room_id":{"type":"string"},"reason":{"type":"string"},"evidence":{"type":"array","items":{"type":"string"}},
      "confidence":{"type":"number","minimum":0,"maximum":1},"status":{"type":"string"}
    }},
    "scope":{"type":"object","required":["scope_id","room_id","description","quantity","unit","confidence","status"],"properties":{
      "scope_id":{"type":"string"},"room_id":{"type":"string"},"damage_id":{"type":["string","null"]},"description":{"type":"string"},
      "quantity":{"type":"number"},"unit":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"status":{"type":"string"}
    }},
    "point":{"type":"array","prefixItems":[{"type":"number"},{"type":"number"}],"minItems":2,"maxItems":2}
  }
}